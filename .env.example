# --- HR login (Google) ---
# OAuth client from Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
# Application type: Web application.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Authorized redirect URI (must match exactly):
#   {BASE_URL}/api/auth/google/callback
# Comma-separated emails allowed to open the HR dashboard. Leave empty to allow any Google account.
ALLOWED_GOOGLE_EMAILS=you@gmail.com
# Long random string used to sign the login session cookie.
SESSION_SECRET=change-me-too

# --- Supabase ---
# Project URL from Supabase → Project Settings → API
SUPABASE_URL=https://prbvimksloftztijgnvr.supabase.co
# service_role key from the same page. Server-only. Never commit this.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Public site URL, used for the Google redirect and upload links in emails. No trailing slash.
# Server-only (not NEXT_PUBLIC_). The dashboard copy-link uses the browser origin.
BASE_URL=http://localhost:3000
